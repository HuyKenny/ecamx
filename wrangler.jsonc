{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecamx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // POZOR (poučka z vian/docs/DEPLOYMENT.md): @astrojs/cloudflare v14 negeneruje
  // deploy z tohoto souboru. Build vyrobí dist/server/wrangler.json (sloučený
  // config) a deployuje/preview se TEN:
  //   astro build && wrangler deploy -c dist/server/wrangler.json
  // Blok env.production se do generovaného configu nepropíše → vše na top-level.
  "routes": [
    { "pattern": "ecamx.com", "custom_domain": true },
    { "pattern": "www.ecamx.com", "custom_domain": true }
  ],

  "assets": { "binding": "ASSETS" },

  // Binding jen kvůli ŽIVÉMU SNÍMKU (`live-snapshot`, D82) — píše ho cron
  // Worker á 5 min, web ho čte (`src/lib/live-snapshot.ts`). Registry a
  // `registry-gone` web dál NEČTE (megabajty, D3) — ty zná jen sync přes REST.
  "kv_namespaces": [{ "binding": "LIVE_KV", "id": "158984aaec6c47eca3e3e6ea29e3cf17" }],

  "observability": { "enabled": true }
}
