{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecamx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // POZOR (poučka z vian/docs/DEPLOYMENT.md): @astrojs/cloudflare v14 negeneruje
  // deploy z tohoto souboru. Build vyrobí dist/server/wrangler.json (sloučený
  // config) a deployuje/preview se TEN:
  //   astro build && wrangler deploy -c dist/server/wrangler.json
  // Blok env.production se do generovaného configu nepropíše → vše na top-level.
  "routes": [
    { "pattern": "ecamx.com", "custom_domain": true },
    { "pattern": "www.ecamx.com", "custom_domain": true }
  ],

  "assets": { "binding": "ASSETS" },

  // Živý snímek (D95): statické soubory assets-only Workeru `ecamx-live` na
  // `ecamx.com/livedata/*` (publikuje GitHub Actions `live.yml` á ~5 min).
  // Prohlížeč je čte přímo (žádný Worker), tenhle Worker přes service binding —
  // `fetch()` na stejnou zónu by route cizího Workeru přeskočil. KV binding
  // (`ecamx-live`, D85) je pryč: na Workers Free je 1 000 zápisů KV denně na
  // celý účet a snímek by jich sám spotřeboval ~860.
  "services": [{ "binding": "LIVE_DATA", "service": "ecamx-live" }],

  "observability": { "enabled": true }
}
