---
/**
 * Shell webu (redesign 17. 11. 2026, D83): horní lišta, levý panel živých
 * kanálů, obsah, patička — rozvržení po vzoru streamovacích webů.
 *
 * **Nesmí importovat `data.ts`** (13 MB katalogu): Layout používá i dynamická
 * stránka modelky, která běží ve Workeru (D82). Všechno, co potřebuje, je
 * v malých modulech (`site.ts`, `labels.ts`, `thumbnail-hosts.ts`) a v
 * `facets.json` / `meta.json` (desítky kB).
 *
 * <head> řeší kompletní SEO — starý WP tu měl díry (homepage bez H1, jedna
 * description na 26 830 stránkách, canonical u Cam4 na cam4.com).
 */
import { canonicalUrl, SITE_NAME, SITE_URL } from '../lib/site';
import { THUMBNAIL_HOSTS } from '../lib/thumbnail-hosts';
import { NETWORK_WEIGHT } from '../lib/network-weight';
import { facetLabel } from '../lib/labels';
import { UI, alternatesFor, langOf, ES_ACTIVE as ES_ROUTES, esPath, type Lang } from '../lib/i18n';
import { ES_PAGES } from '../content/es-pages';
import facets from '../data/facets.json';
import meta from '../data/meta.json';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	/** Absolutní URL OG obrázku. Default je brandovaný, NE náhled modelky. */
	image?: string;
	/** Popis `image` pro og:image:alt (jinak text značky k výchozímu obrázku). */
	imageAlt?: string;
	/** `profile` na stránce modelky, jinde `website`. */
	ogType?: 'website' | 'profile';
	/**
	 * Dotaz živé mřížky stránky (`all~60`, `t:latina~24` …). Layout ho
	 * přednačte v <head>, takže data dorazí dřív, než se vykoná modul (D63/D82).
	 */
	liveQuery?: string;
	/** Čas buildu; dynamická stránka posílá čas snímku. */
	built?: string;
	/** Jazyk stránky (D94). Default podle cesty: `/es/…` = es. */
	lang?: Lang;
}

const { title, description, noindex = false, image, imageAlt, ogType = 'website', liveQuery, built } = Astro.props;
const lang: Lang = Astro.props.lang ?? langOf(Astro.url.pathname);
const u = UI[lang];
const es = lang === 'es';
// hreflang jen na párových stránkách (D94) a jen u indexovatelných.
const alternates = noindex ? [] : alternatesFor(Astro.url.pathname);
const otherLang = alternates.find((a) => a.hreflang === (es ? 'en' : 'es'));
const esRail = ES_ROUTES.filter((r) => r.slug).map((r) => ({ href: esPath(r.slug), label: ES_PAGES[r.slug]?.label ?? r.slug }));
const canonical = canonicalUrl(Astro.url.pathname);
// Brandovaný OG obrázek záměrně: adult náhled se na sociálních sítích blokuje
// a navíc expiruje (Cam4 podepsané URL).
const ogImage = image ?? new URL('/og-default.png', SITE_URL).toString();
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;

type Facet = { slug: string; label: string; count: number };
const F = facets as unknown as { categories: Facet[]; curated?: Facet[] };
/** Panel: nejsilnější kategorie (kurátorské „money" první, D23). */
const railCats: Facet[] = [...(F.curated ?? []), ...F.categories]
	.filter((c, i, all) => all.findIndex((x) => x.slug === c.slug) === i)
	.sort((a, b) => b.count - a.count)
	.slice(0, 10);
const CAT_COLORS = ['#ff4f6d', '#b8f23a', '#ffd23f', '#7cc8ff', '#f9a03f'];
const RAIL_N = 10;
const builtAt = built ?? (meta as { generatedAt: string }).generatedAt;
---

<!doctype html>
<html lang={lang}>
<head>
	<meta charset="utf-8" />
	{/*
		  `viewport-fit=cover` je podmínka pro `env(safe-area-inset-*)` v CSS.
		  Bez něj se insety vyhodnotí jako 0 a sticky CTA na iPhonu leží
		  v gesture zóně — swipe-up místo kliknutí = ztracená konverze.
		*/}
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="ecamx-built" content={builtAt} />
	<meta name="theme-color" content="#16161c" />

	{/* noindex stránka nedostane canonical ani og:url — konfliktní signály. */}
	{noindex
		? <meta name="robots" content="noindex, follow" />
		: <>
			<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
			<link rel="canonical" href={canonical} />
		</>
	}

	<meta property="og:type" content={ogType} />
	<meta property="og:site_name" content={SITE_NAME} />
	<meta property="og:locale" content={es ? 'es_ES' : 'en_US'} />
	{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, SITE_URL).toString()} />)}
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImage} />
	{!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
	<meta property="og:image:alt" content={image && imageAlt ? imageAlt : 'eCamx — live cams from every big cam site in one grid'} />
	{!noindex && <meta property="og:url" content={canonical} />}
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	{/* MUSÍ být blokující a v <head>: rozhoduje o věkové liště ještě před prvním
	    vykreslením. Modulový skript je odložený, takže když lištu odkrýval on,
	    naskočila v 1 625 ms a posunula celý <main> — jediný layout shift na
	    stránce (CLS 0,1204 na /cams/bbw/, iPhone + slow 4G). Takhle je CLS 0
	    pro oba případy: kdo lištu ještě neodklikl, vidí ji od prvního snímku;
	    kdo ano, tomu se nikdy neukáže. */}
	<script is:inline>
		/*
		 * Rozhoduje o dvou věcech ještě před prvním vykreslením: jestli se ukáže
		 * věková lišta a jestli se vůbec smí načíst analytika.
		 *
		 * **Souhlas se vyžaduje tam, kde ho vyžaduje právo.** Lišta záměrně
		 * neblokuje obsah (rozhodnutí 16. 8., HTML musí zůstat crawlovatelné),
		 * takže „bez kliknutí neměříme" by u všech znamenalo měřit skoro nikoho.
		 * Pro EU/EHP/UK je opt-in povinný, mimo ně stačí zveřejnění a možnost
		 * odmítnout — proto se region rozhoduje z časové zóny prohlížeče. Není
		 * to autorita na jurisdikci, ale je to zdarma, bez requestu a bez
		 * latence; **když se nedá zjistit, bere se to jako EU** (bezpečný směr).
		 */
		(function () {
			var age = null, consent = null, watch = null;
			try {
				age = localStorage.getItem('ecamx-age-ok');
				consent = localStorage.getItem('ecamx-consent');
				watch = localStorage.getItem('ecamx-watch');
			} catch (e) { /* privátní režim → lišta se prostě zobrazí */ }

			var needsConsent = true;
			try {
				var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
				// Evropa + kousky EU/EHP mimo pásmo „Europe/" (Kanáry, Madeira,
				// Azory, Island, Kypr, Ceuta) a UK spadá pod Europe/London.
				needsConsent = /^Europe\//.test(tz)
					|| /^Atlantic\/(Canary|Madeira|Azores|Reykjavik)$/.test(tz)
					|| tz === 'Asia/Nicosia' || tz === 'Africa/Ceuta';
			} catch (e) { /* Intl chybí → zůstává true */ }

			var root = document.documentElement;
			// Mřížky skrývají statické karty, dokud nedorazí živá data — jen s JS.
			root.classList.add('js');
			// Lišta zmizí, až je odkliknutý věk A (mimo EU, nebo je rozhodnuto
			// o souhlasu). Jinak by se EU návštěvník neměl kde vyjádřit.
			if (age === '1' && (!needsConsent || consent)) root.classList.add('age-ok');
			if (needsConsent) root.classList.add('needs-consent');
			// Odznak „N z tvých je live" je v HTML od prvního snímku a CSS ho
			// schová, dokud tahle třída není. Kdyby ho odkrýval odložený modul,
			// posune hlavičku — a přesně tím stál `/finder/` CLS 0,2724 (past 52).
			// Kdo nikoho nesleduje, nezaplatí ani jeden request (viz modul níž).
			if (watch && watch !== '[]') {
				root.classList.add('has-follows');
				// Kolik řádků má `/my/` rezervovat, aby se po dosypání seznamu
				// neposunula patička. Bez toho měřeno CLS 0,1208 (past 52).
				try {
					var n = JSON.parse(watch).length;
					if (n > 0) root.style.setProperty('--watch-rows', String(Math.min(n, 200)));
				} catch (e) { /* rozbitý zápis → rezervace se prostě neudělá */ }
			}
			/**
			 * Uložený filtr mřížky podle sítě. Aplikuje se **stylem, tady a hned** —
			 * kdyby karty skrýval odložený modul, posunul by obsah po dopadu
			 * stránky (past 52 a 73). Selektor se skládá z `data-network`, které
			 * karta nese odjakživa, takže to nestojí ani bajt v HTML (past 31).
			 */
			try {
				var sites = JSON.parse(localStorage.getItem('ecamx-sites') || '[]');
				if (Array.isArray(sites) && sites.length) {
					var ok = sites.filter(function (x) { return /^[a-z0-9]{1,20}$/.test(x); });
					if (ok.length) {
						var sel = ok.map(function (x) { return '[data-network="' + x + '"]'; }).join('');
						var st = document.createElement('style');
						st.setAttribute('data-site-filter', ok.join(','));
						st.textContent = '.card:not(' + sel.split('][').join(']):not([') + '){display:none}';
						document.head.appendChild(st);
					}
				}
			} catch (e) { /* rozbitý zápis → filtr se prostě neuplatní */ }

			// Čte to loader gtag.js i obsluha tlačítek níž.
			window.__ecamxConsent = { needed: needsConsent, value: consent };
		})();
	</script>
	{/* Google Analytics 4. `is:inline` je nutné, aby Astro stub nezabalilo do
	    modulu — `gtag()` musí být globální funkce, jinak ho `gtag('config')`
	    nenajde.

	    **`gtag.js` se NENAČÍTÁ hned.** Změřeno 19. 8. na homepage (mobil,
	    4× CPU throttle, slow 4G): s GA je TBT 2 110 ms, bez GA **870 ms** —
	    tedy 1 240 ms blokovaného hlavního vlákna za třetí stranu. `async` sice
	    neblokuje parsování HTML, ale vykonání toho skriptu ano.

	    Řešení bez ztráty dat: stub definuje `gtag()` hned, takže všechno, co
	    stránka naměří, se odloží do `dataLayer`, a knihovna se natáhne až
	    v nečinnosti nebo při první interakci — co přijde dřív. Po načtení GA
	    frontu z `dataLayer` zpracuje, takže `page_view` ani `go_click` nezmizí.
	    `visibilitychange` je pojistka pro případ, že návštěvník odchází dřív,
	    než prohlížeč vůbec zahálí.

	    POZOR: až se bude dodělávat plná CSP, tohle potřebuje
	    `script-src https://www.googletagmanager.com` a inline hash, a
	    `connect-src https://*.google-analytics.com`. Bez toho GA umlčíme.

	    Měřená čísla budou nižší než realita — na adult webu blokuje
	    googletagmanager velká část návštěvníků (proto celá věc s /go/, D17).
	    Nezkreslený počet requestů je v Cloudflare dashboardu. */}
	<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		/*
		 * Consent Mode v2. Výchozí stav je ODMÍTNUTO pro všechno — teprve pak
		 * smí přijít `config`, jinak by první `page_view` odešel bez souhlasu.
		 *
		 * Mimo EU se hned povolí `analytics_storage`; v EU se čeká na tlačítko
		 * a `gtag.js` se do té doby VŮBEC NENAČTE. To je silnější než jen
		 * odmítnutý consent: Google by při `denied` posílal cookieless pingy,
		 * a to je pořád zpracování dat návštěvníka, které nikdo nepovolil.
		 * Dokud se knihovna nenačte, `page_view` a všechny události čekají
		 * v `dataLayer` — po souhlasu se odešlou, po odmítnutí se zahodí.
		 */
		gtag('consent', 'default', {
			ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
			analytics_storage: 'denied', wait_for_update: 500,
		});
		gtag('js', new Date());
		gtag('config', 'G-JSSZP2XFBL');
		(function () {
			var c = window.__ecamxConsent || { needed: true, value: null };
			var allowed = !c.needed || c.value === 'granted';
			if (allowed) gtag('consent', 'update', { analytics_storage: 'granted' });
			var loaded = false;
			// Vystaveno tlačítkům v liště: po souhlasu se knihovna natáhne hned
			// a zpracuje frontu, takže se neztratí ani `page_view`.
			window.__ecamxLoadGa = function () { allowed = true; load(); };
			function load() {
				if (loaded || !allowed) return;
				loaded = true;
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=G-JSSZP2XFBL';
				document.head.appendChild(s);
			}
			// Nečinnost s tvrdým stropem 3 s — na pomalém mobilu se prohlížeč
			// „nudy" nedočká sám, ale déle už bychom riskovali ztracené návštěvy.
			if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
			else setTimeout(load, 2000);
			// První dotek/klik/scroll znamená, že návštěvník zůstává → GA hned.
			['pointerdown', 'keydown', 'scroll'].forEach(function (e) {
				addEventListener(e, load, { once: true, passive: true });
			});
			// Odchod ze stránky: poslat, co je ve frontě, dokud to jde.
			addEventListener('visibilitychange', function () {
				if (document.visibilityState === 'hidden') load();
			});
		})();
	</script>

	<meta name="rating" content="adult" />
	<meta name="RATING" content="RTA-5042-1996-1400-1577-RTA" />

	<link rel="icon" href="/favicon.ico" sizes="32x32" />
	<link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
	<link rel="apple-touch-icon" href="/favicon-180.png" />
	<link rel="manifest" href="/manifest.webmanifest" />
	<link rel="preload" href="/fonts/bricolage-latin.v1.woff2" as="font" type="font/woff2" crossorigin />

	{/* Náhledy jdou z cizích CDN — preconnect na 6 nejčastějších, zbytek dns-prefetch. */}
	{THUMBNAIL_HOSTS.slice(0, 6).map((h) => (
		<link rel="preconnect" href={`https://${h}`} />
	))}
	{THUMBNAIL_HOSTS.slice(6).map((h) => (
		<link rel="dns-prefetch" href={`https://${h}`} />
	))}

	{/* Živá data mřížky se začnou stahovat UŽ TEĎ (D63) — stejná URL, jakou
	    pak složí `src/scripts/live.ts`, jinak by se přednačtení nevyužilo. */}
	{liveQuery && (
		<link rel="preload" as="fetch" crossorigin="anonymous" href={`/api/live/grid/?v=2&q=${liveQuery}`} />
	)}

	<slot name="head" />
</head>
<body class="bg-ink-950 text-ink-50" data-network-weight={JSON.stringify(NETWORK_WEIGHT)}>
	<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:p-3">{u.skip}</a>

	<div id="age-notice" class="age-notice border-b border-ink-800 bg-ink-900 text-xs sm:text-sm">
		<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-2 gap-y-1 px-3 py-1.5">
			<strong class="text-accent">18+</strong>
			<span class="text-ink-200">
				{u.adult}<span class="consent-only">{u.analytics}</span>
			</span>
			<a href="/terms/" class="text-ink-400 underline hover:text-white">{u.terms}</a>
			<a href="/privacy/" class="consent-only text-ink-400 underline hover:text-white">{u.privacy}</a>
			<span class="ml-auto flex gap-2">
				<button
					type="button" id="age-dismiss"
					class="rounded bg-ink-700 px-3 py-1 font-medium text-white hover:bg-ink-600"
				><span class="consent-only">{u.accept}</span><span
					class="no-consent-only">{es ? 'Tengo 18+' : "I'm 18+"}</span></button>
				{/* Stejná velikost i tvar jako „Accept" — odmítnutí musí být
				    stejně snadné, jinak souhlas není platný (D45). */}
				<button
					type="button" id="consent-decline"
					class="consent-only rounded bg-ink-700 px-3 py-1 font-medium text-white hover:bg-ink-600"
				>{u.decline}</button>
			</span>
		</div>
	</div>

	<header class="topbar">
		<button type="button" class="rail-toggle" data-rail-toggle aria-label={u.liveChannels} aria-expanded="false" aria-controls="rail">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
		</button>
		<a href={es ? '/es/' : '/'} class="brand" aria-label={u.home}>
			<img src="/logo-mark.svg" alt="" width="34" height="34" />
			<span class="brand-word">e<b>Camx</b></span>
		</a>
		<nav aria-label={u.main} class="topnav">
			<a href="/cams/" aria-current={current('/cams/')}>{u.browse}</a>
			<a href={es ? '/es/mujeres-desnudas/' : '/girls/'} aria-current={current(es ? '/es/mujeres-desnudas/' : '/girls/')}>{u.girls}</a>
			<a href="/couples/" aria-current={current('/couples/')}>{u.couples}</a>
			<a href={es ? '/es/hombres/' : '/guys/'} aria-current={current(es ? '/es/hombres/' : '/guys/')}>{u.guys}</a>
			<a href={es ? '/es/trans/' : '/trans/'} aria-current={current(es ? '/es/trans/' : '/trans/')}>{u.trans}</a>
		</nav>
		<a href="/finder/" class="search" aria-label={u.findModel}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
			<span>{u.findModelDots}</span>
		</a>
		{/* „Tvoje modelky" — ukazuje se jen s `has-follows` (blokující skript), nic neskáče. */}
		<a href="/my/" class="watch-link" data-watch-link>
			{es ? 'Tus modelos' : 'Your models'}<span class="watch-count" data-watch-count hidden></span>
		</a>
	</header>

	<div class="shell">
		<aside class="rail" id="rail" aria-label={u.liveChannels}>
			<button type="button" class="rail-close" data-rail-toggle aria-label={u.closeMenu}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
			</button>
			<div class="rail-h"><span>{u.liveNow}</span><a href={es ? '/es/' : '/'}>{u.seeAll}</a></div>
			{/* Sloty mají pevnou výšku; plní je `live.ts` ze snímku (D82). */}
			<nav class="rail-list" data-rail data-n={RAIL_N} aria-label={u.mostWatched}>
				{Array.from({ length: RAIL_N }, () => (
					<span class="rail-item" aria-hidden="true">
						<span class="rail-ph"></span>
						<span class="rail-name">&nbsp;</span>
						<span class="rail-v"></span>
					</span>
				))}
			</nav>
			<div class="rail-sep"></div>
			<div class="rail-h"><span>{u.browse}</span></div>
			{es ? (
			<nav class="rail-list" aria-label={u.browse}>
				{esRail.map((r, i) => (
					<a class="rail-cat" href={r.href}><i style={`background:${CAT_COLORS[i % CAT_COLORS.length]}`}>{r.label.charAt(0)}</i>{r.label}</a>
				))}
				<a class="rail-cat" href="/site/"><i style="background:#f9a03f">S</i>{u.camSites}</a>
			</nav>
			) : (
			<nav class="rail-list" aria-label="Browse">
				<a class="rail-cat" href="/girls/"><i style="background:#ff4f6d">G</i>Girls</a>
				<a class="rail-cat" href="/couples/"><i style="background:#ffd23f">C</i>Couples</a>
				<a class="rail-cat" href="/guys/"><i style="background:#7cc8ff">M</i>Guys</a>
				<a class="rail-cat" href="/trans/"><i style="background:#b8f23a">T</i>Trans</a>
				<a class="rail-cat" href="/site/"><i style="background:#f9a03f">S</i>Cam sites</a>
				<a class="rail-cat" href="/country/"><i style="background:#d7d6df">W</i>Countries</a>
				<a class="rail-cat" href="/guides/"><i style="background:#c9a7ff">?</i>Guides</a>
			</nav>
			)}
			{!es && <>
			<div class="rail-sep"></div>
			<div class="rail-h"><span>Popular categories</span><a href="/cams/">All</a></div>
			<nav class="rail-list" aria-label="Popular categories">
				{railCats.map((c, i) => (
					<a class="rail-cat" href={`/cams/${c.slug}/`}>
						<i style={`background:${CAT_COLORS[i % CAT_COLORS.length]}`}>{facetLabel(c.slug, c.label).charAt(0)}</i>{facetLabel(c.slug, c.label)}
					</a>
				))}
			</nav>
			</>}
