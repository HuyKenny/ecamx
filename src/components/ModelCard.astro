---
/**
 * Karta modelky ve statickém HTML (build). Markup vyrábí `cardHtml()`
 * ze `src/lib/card.ts` — tutéž funkci volá prohlížeč, když mřížku plní ze
 * živého snímku (D82). Proto se tady NIC nepřidává do markupu: změna patří
 * do `card.ts`, jinak se statická a živá karta rozejdou.
 *
 * **Z karty se ven nechodí** (D71) — jediný odkaz vede na `/live/{page}/`.
 */
import type { Model } from '../lib/data';
import { cardHtml } from '../lib/card';
import { toCard } from '../lib/card-model';

interface Props {
	model: Model;
	eager?: boolean;
	/** První karta na stránce — `fetchpriority="high"` (LCP). */
	priority?: boolean;
	/** Karta ze starého buildu: nevíme, jestli vysílá (mřížka ji vymění). */
	stale?: boolean;
}
const { model: m, eager = false, priority = false, stale = true } = Astro.props;

---
<Fragment set:html={cardHtml(toCard(m, stale), { eager, priority })} />
