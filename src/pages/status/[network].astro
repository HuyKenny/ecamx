---
/**
 * „Is Chaturbate down?" (D91) — live status of a cam site from our own
 * 5-minute check (cron `ecamx-cron`, snapshot in KV, D82).
 *
 * Honest wording matters: when our fetch fails, that can be the site OR our
 * side, so the page says "we could not reach its feed", never "it is down".
 * Rules: no `data.ts` (13 MB into the Worker, AGENTS 135), no inline logic
 * scripts (CSP). The snapshot read is memoised per isolate (`readSnapshot`).
 * Searched ~2,500×/month in the US ("chaturbate down", "down detector", …).
 */
// Breadcrumbs.astro se sem NEimportuje: bundler ho sdílí v chunku s data.ts
// a SSR stránka by do Workeru přitáhla celý katalog (AGENTS 135, D91).
import Layout from '../../layouts/Layout.astro';
import { readSnapshot, isFresh } from '../../lib/live-snapshot';
import { NETWORK_IDS, pick } from '../../lib/live-grid';
import { NETWORK_LABELS } from '../../lib/labels';
import { SITE_NAME } from '../../lib/site';
import { withSecurityHeaders } from '../../lib/security-headers';

export const prerender = false;
const CSP = '__ECAMX_CSP__';

const net = (Astro.params.network ?? '').toLowerCase();
if (!NETWORK_IDS.has(net)) return new Response(null, { status: 404 });
const label = NETWORK_LABELS[net] ?? net;
const snap = await readSnapshot();
const now = Date.now();
const state = snap?.nets[net];
const fresh = !!snap && isFresh(snap, net, now);
const mins = (ts: number) => Math.max(0, Math.round((now - ts) / 60_000));
const recs = snap ? snap.m.filter((r) => r.n === net) : [];
const live = state?.count ?? recs.length;
const privateNow = recs.filter((r) => r.pr).length;
const viewers = recs.map((r) => r.v ?? 0).filter((v) => v > 0);
const watching = viewers.reduce((a, b) => a + b, 0);
const top = snap ? pick(snap.m, `n:${net}`, 8).cards : [];
const others = snap ? Object.entries(snap.nets).filter(([id]) => id !== net && NETWORK_IDS.has(id))
	.sort((a, b) => b[1].count - a[1].count) : [];
const fmt = (n: number) => n.toLocaleString('en-US');
const checkedAt = state ? new Date(state.ts).toISOString().slice(11, 16) : null;

const verdict = !snap
	? { tone: 'unknown', head: 'Status unavailable right now', text: 'Our live check has no recent data. That says nothing about the site itself — try opening it directly.' }
	: fresh
		? { tone: 'up', head: `${label} is up`, text: `Our check ${mins(state!.ts)} min ago (${checkedAt} UTC) found ${fmt(live)} live rooms on ${label}.` }
		: { tone: 'warn', head: `We couldn't reach ${label}'s feed`, text: `Our last successful check was ${state ? `${mins(state.ts)} min ago` : 'a while ago'}. That can be a problem on ${label}'s side or on ours — if the site loads for you, it is up.` };

const title = `Is ${label} Down? Live Status, Checked Every 5 Minutes | ${SITE_NAME}`;
const description = `Is ${label} down right now? Our own check of ${label}'s live rooms every 5 minutes — when it last worked, how many rooms are live, and what to try if it won't load.`;
const faq = [
	{ q: `Is ${label} down right now?`, a: `${verdict.head}. ${verdict.text}` },
	{ q: `Why won't ${label} load for me?`, a: `If our check sees live rooms, the site is up and the problem is local: an age-verification page, a network that blocks adult sites (work, school, some mobile carriers), or a stale browser cache. Try another network or a private window.` },
];
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

withSecurityHeaders(Astro.response.headers, CSP);
Astro.response.headers.set('cache-control', 'public, max-age=60');
const tone = { up: 'border-emerald-500/40 bg-emerald-500/10', warn: 'border-amber-500/40 bg-amber-500/10', unknown: 'border-ink-700 bg-ink-900' }[verdict.tone];
---
<Layout title={title} description={description} built={snap ? new Date(snap.ts).toISOString() : undefined}>
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
	<div class="mx-auto max-w-3xl">
		<nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400"><a href="/" class="hover:text-white">Home</a> › <a href="/status/" class="hover:text-white">Site status</a> › <span>{label}</span></nav>
		<h1 class="text-2xl font-extrabold sm:text-3xl">Is {label} down right now?</h1>

		<div class={`mt-5 rounded-lg border p-5 ${tone}`} role="status">
			<p class="text-xl font-bold text-ink-50">{verdict.head}</p>
			<p class="mt-1 text-ink-200">{verdict.text}</p>
		</div>

		{fresh && (
			<dl class="mt-5 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
				<div class="rounded-md border border-ink-800 p-3"><dt class="text-ink-400">Live rooms</dt><dd class="text-lg font-bold text-ink-50">{fmt(live)}</dd></div>
				<div class="rounded-md border border-ink-800 p-3"><dt class="text-ink-400">In a private show</dt><dd class="text-lg font-bold text-ink-50">{fmt(privateNow)}</dd></div>
				<div class="rounded-md border border-ink-800 p-3"><dt class="text-ink-400">People watching</dt><dd class="text-lg font-bold text-ink-50">{viewers.length ? fmt(watching) : 'not published'}</dd></div>
			</dl>
		)}

		{top.length > 0 && (
			<section class="mt-8" aria-labelledby="top-h">
				<h2 id="top-h" class="mb-3 text-lg font-bold">Live on {label} at our last check</h2>
				<ul class="flex flex-wrap gap-2">
					{top.map((c) => <li><a href={`/live/${c.p}/`} class="pill">{c.u}</a></li>)}
				</ul>
				<p class="mt-3 text-sm"><a href={`/site/${net}/`} class="text-accent underline">See every live {label} room →</a></p>
			</section>
		)}

		<section class="prose-ecamx mt-8 space-y-3 text-ink-200" aria-labelledby="why-h">
			<h2 id="why-h">If {label} won't load for you</h2>
			<ul>
				<li><strong>Age verification.</strong> Some US states and countries require it before you can watch — that screen is part of the site, not an outage.</li>
				<li><strong>Your network blocks it.</strong> Work, school and some mobile networks filter adult sites. Try another connection.</li>
				<li><strong>Old cache or a bad extension.</strong> Open the site in a private window.</li>
				<li><strong>A look-alike address.</strong> Type the domain carefully — typo domains are a common trap.</li>
			</ul>
			<p>How this works: eCamx fetches the public live feed of every site we cover every five minutes. This page shows the result of that check, not reports from users.</p>
		</section>

		{others.length > 0 && (
			<section class="mt-8" aria-labelledby="oth-h">
				<h2 id="oth-h" class="mb-3 text-lg font-bold">Other cam sites</h2>
				<ul class="divide-y divide-ink-800 text-sm">
					{others.map(([id, s]) => (
						<li class="flex items-center justify-between py-2">
							<a href={`/status/${id}/`} class="text-ink-200 hover:text-white">{NETWORK_LABELS[id] ?? id}</a>
							<span class={isFresh(snap!, id, now) ? 'text-emerald-400' : 'text-amber-400'}>
								{isFresh(snap!, id, now) ? `up · ${fmt(s.count)} live` : 'feed not reached'}
							</span>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
</Layout>
