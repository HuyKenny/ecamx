---
/**
 * Gender rozcestník, stránka 2+ (`/girls/2/`). Stránka 1 zůstává
 * v `src/pages/[gender].astro`.
 */
import GridPage from '../../components/GridPage.astro';
import { allByGender, gridWindow } from '../../lib/data';
import { GRID, gridPageCount } from '../../lib/paging';

export function getStaticPaths() {
	// POZOR: `getStaticPaths()` běží v izolovaném rozsahu a na konstanty
	// z frontmatteru NEDOSÁHNE — modulový `const ROUTES` tady spadl na
	// „ReferenceError: ROUTES is not defined" při prerenderu. Importy fungují
	// (proto je `src/lib/paging.ts` vlastní modul), lokální data musí být uvnitř.
	const routes: Record<string, { gender: string; label: string }> = {
		girls: { gender: 'female', label: 'Girl' },
		guys: { gender: 'male', label: 'Guy' },
		couples: { gender: 'couple', label: 'Couple' },
		trans: { gender: 'trans', label: 'Trans' },
	};
	const out = [];
	for (const [slug, cfg] of Object.entries(routes)) {
		const pages = gridPageCount(allByGender(cfg.gender).length, GRID);
		for (let n = 2; n <= pages; n++) {
			out.push({ params: { gender: slug, page: String(n) }, props: cfg });
		}
	}
	return out;
}

const { gender, label } = Astro.props;
const win = gridWindow(allByGender(gender), Number(Astro.params.page), GRID);
---
<GridPage
	heading={`Live ${label} Cams`}
	base={`/${Astro.params.gender}/`}
	win={win}
	visible={GRID.visible}
	crumbs={[{ label: `${label} cams`, href: `/${Astro.params.gender}/` }]}
	countLabel={`${label.toLowerCase()} models`}
/>
