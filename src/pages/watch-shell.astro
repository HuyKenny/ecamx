---
/**
 * Shell of the dynamic page of a live model WITHOUT a static page (D82 → D95).
 *
 * Until 23. 11. 2026 `/watch/[p].astro` was rendered in the Worker from the
 * 5 MB KV snapshot. On Workers Free (10 ms CPU) a full Astro render per view
 * is a risk, so the page is now this prerendered shell: the catch-all
 * (`src/pages/[...path].ts`) finds the model in a `/livedata/w/` shard and
 * fills the `data-w-*` slots with `HTMLRewriter` (`src/lib/watch-render.ts`)
 * — streaming, no template render, ~1 ms.
 *
 * Slot attributes (all removed or filled by the renderer):
 *   data-w-if="cond"        element stays only when the condition holds
 *   data-w-text="key"       text content
 *   data-w-html="key"       trusted HTML built by the renderer (escaped values)
 *   data-w-attr="a:key,…"   attributes (empty value = attribute removed)
 *   data-w-class="key"      extra class
 * The LiveGrids get `data-q` (similar facet) and `data-x` (this model) there.
 *
 * The shell itself is `noindex` and linked from nowhere. Same rules as the
 * old page: no `data.ts`, no inline scripts (CSP), player in `scripts/watch.ts`.
 */
import Layout from '../layouts/Layout.astro';
import LiveGrid from '../components/LiveGrid.astro';

export const prerender = true;
---
<Layout title="__W_TITLE__" description="__W_DESC__" noindex ogType="profile">
	<div class="theater" data-w-class="theater">
		<div class="theater-main">
			<div class="player-frame" data-watch-player data-w-attr="data-embed:embed,data-autoplay:autoplay">
				<img src="/logo-mark.svg" alt="" class="absolute inset-0 h-full w-full object-cover" referrerpolicy="no-referrer" fetchpriority="high" data-w-attr="src:poster,alt:alt" />
				<video data-w-if="hls" class="absolute inset-0 h-full w-full bg-black object-contain" data-watch-hls
					data-w-attr="data-network:n,data-nick:u,data-src:hls,poster:poster"
					muted autoplay playsinline controls></video>
				<button data-w-if="iframe" type="button" class="play-overlay" data-watch-play data-w-attr="aria-label:playLabel">
					<span class="play-icon" aria-hidden="true">▶</span>
					<span data-w-text="watchU">Watch live</span>
				</button>
				<a data-w-if="link" href="/" class="play-overlay" rel="nofollow sponsored" target="_blank" data-w-attr="href:cta">
					<span class="play-icon" aria-hidden="true">▶</span>
					<span data-w-text="openU">Open stream</span>
				</a>
			</div>
		</div>
		<aside data-w-if="side" class="theater-side" aria-label="Live chat">
			<div class="side-h"><span class="live-dot"></span>Live chat</div>
			<div class="side-cta">
				<p data-w-text="sideP">Chat, tips and private shows happen on the cam site — free account, no card needed to watch.</p>
				<a href="/" rel="nofollow sponsored" target="_blank" class="btn-cta w-full" data-w-attr="href:chat" data-w-text="chatU">Chat →</a>
			</div>
			<div class="side-h" data-w-text="likeU">Live now like her</div>
			<LiveGrid cards={[]} q="all" n={6} class="is-list" />
		</aside>
	</div>

	<div class="watch-bar flex flex-wrap items-start gap-3" data-live-scope>
		<span class="net-dot" aria-hidden="true" data-w-class="netDot" data-w-text="netLetter">?</span>
		<div class="min-w-0 flex-1">
			<h1 class="text-2xl font-extrabold sm:text-3xl" data-w-text="u">Live model</h1>
			<p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-400">
				<span class="badge bg-live" data-w-attr="data-live-badge:key">Live now</span>
				<span data-w-if="pr" class="badge bg-ink-700">Private show</span>
				<span data-w-if="v" data-viewers data-w-text="viewers"></span>
				<span data-w-text="line"></span>
			</p>
			<p data-w-if="j" class="mt-2 max-w-2xl text-sm text-ink-200" data-w-text="j"></p>
			<p data-w-if="tags" class="mt-3 flex flex-wrap gap-2" data-w-html="tags"></p>
		</div>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" class="zap-btn" data-zap-next
				data-w-attr="data-zap-q:topKey,data-zap-x:key,data-zap-name:u"
				title="Next live cam (N)">Next <span aria-hidden="true">▶</span></button>
			<a href="/" class="btn-cta" rel="nofollow sponsored" target="_blank" data-w-attr="href:cta" data-w-text="ctaText">Chat &amp; tip on the cam site →</a>
		</div>
	</div>
	<p class="mt-3 text-xs text-ink-500" data-w-text="disclaimer">Free to watch. eCamx earns a commission if you buy tokens — it costs you nothing extra.</p>

	<section data-w-if="chatSimilar" class="mt-8">
		<h2 class="mb-3 text-lg font-bold" data-w-text="similarH">Live now, similar</h2>
		<LiveGrid cards={[]} q="all" n={6} />
	</section>

	<script>
		import '../scripts/watch';
		import '../scripts/zap';
	</script>
</Layout>
