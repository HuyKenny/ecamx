			<p class="mb-3 max-w-3xl text-sm text-ink-400">
				The names people look up most often — all of them streaming right now.
			</p>
			<div class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
				{searched.map((m) => (
					<a href={`/live/${m.page}/`} class="text-ink-300 underline decoration-ink-700 hover:text-white">{m.displayName}</a>
				))}
			</div>
		</section>
	)}

	{popular.length > 0 && (
		<section class="mt-8" aria-labelledby="popular-h">
			<h2 id="popular-h" class="mb-3 text-lg font-bold">Popular cam models</h2>
			<div class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
				{popular.map((m) => (
					<a href={`/live/${m.page}/`} class="text-ink-300 underline decoration-ink-700 hover:text-white">{m.displayName}</a>
				))}
			</div>
		</section>
	)}

	{/* Na mobilu je hlavní CTA po odscrollování pryč — tohle ho drží po ruce. */}
	<div class="sticky-cta">
		<a
			href={model.online ? ctaLive : ctaOffline}
			rel="nofollow sponsored noopener" target={outTarget}
			class="btn-cta flex-1"
			data-cta-offline={model.online ? undefined : true}
			data-live-href={model.online ? undefined : ctaLive}
			data-live-text={`Chat & tip ${model.displayName} →`}
		>{model.online ? `Chat & tip ${model.displayName} →` : `Follow ${model.displayName} →`}</a>
	</div>
	{/* Aby sticky lišta nezakrývala patičku. */}
	<div class="h-[68px] md:hidden" aria-hidden="true"></div>

	<script>
		// Vloží iframe teprve po kliknutí. Klik je zároveň ta uživatelská
		// interakce, která rámec vyjímá z Chrome Heavy Ad Intervention.
		// `gtag` je globál z `is:inline` stubu v <head> (AGENTS.md bod 31), takže
		// o něm TypeScript nic neví — a měření nesmí nikdy rozbít přehrávač,
		// proto try/catch. Stejný helper jako v Layout.astro.
		const ga = (name: string, params?: Record<string, unknown>) => {
			try { (window as unknown as { gtag?: Function }).gtag?.('event', name, params); }
			catch { /* přehrávač má přednost před měřením */ }
		};

		/**
		 * Lepivé CTA se odkryje, až přehrávač (nebo náhled) vyjede z obrazovky —
		 * nad ohybem by soutěžilo s hlavním tlačítkem. Místo pro pásek je
		 * rezervované v CSS, takže odkrytí nic neposune.
		 */
		const stickyCta = document.querySelector<HTMLElement>('[data-sticky-cta]');
		const playerBox = document.querySelector<HTMLElement>('[data-player]');
		if (stickyCta && playerBox && 'IntersectionObserver' in window) {
			new IntersectionObserver(([entry]) => {
				stickyCta.classList.toggle('is-on', !entry.isIntersecting);
			}, { rootMargin: '-64px 0px 0px 0px' }).observe(playerBox);
		}

		const frame = document.querySelector<HTMLElement>('[data-player][data-embed]');
		const play = frame?.querySelector<HTMLButtonElement>('[data-play]');
		let started = false;

		/**
		 * Pustí rámec s přehrávačem do plochy.
		 *
		 * `mode` říká, co ho spustilo: `click` je tlačítko, `auto` je stránka,
		 * která se stavěla jako offline a živá kontrola zjistila, že modelka
		 * vysílá. Do 29. 8. se v tom druhém případě jen odkrylo tlačítko —
		 * Kenny: „stream neběží a musíme zmáčknout play." U sítí, kde autoplay
		 * měřeně projde (`AUTOPLAY_SAFE`), se proto pustí sám; u ostatních
		 * (streamate nemá ztišené video, XLoveCam a LiveJasmin jsou na
		 * EasyListu) zůstává tlačítko, protože rámec by stejně nehrál.
		 */
		function startEmbed(mode: 'click' | 'auto'): void {
			if (started || !frame) return;
			const src = frame.dataset.embed;
			if (!src) return;
			started = true;
			const el = document.createElement('iframe');
			el.src = src;
			el.title = frame!.dataset.title ?? 'Live webcam';
			el.allowFullscreen = true;
			// Site-wide politika stačí — plnou URL profilu sítím posílat nemusíme.
			el.referrerPolicy = 'strict-origin-when-cross-origin';
			el.setAttribute('allow', 'autoplay; fullscreen');
			// `replaceChildren()` smete i klikací vrstvu nad streamem — na offline
			// stránce je předrenderovaná a skrytá, takže ji vrátíme a odkryjeme.
			// Bez toho by klik do videa na povýšené stránce nevydělal nic.
			const hit = frame.querySelector<HTMLElement>('.player-hit');
			frame.replaceChildren(el);
			if (hit) { hit.hidden = false; frame.appendChild(hit); }
			if (mode === 'click') {
				// Tlačítko zmizelo i s fokusem; bez tohohle spadne focus na <body>
				// a klávesnicový uživatel ztratí pozici na stránce. Při `auto`ne:
				// fokus bere ten, kdo o něj požádal, ne stránka sama od sebe.
				el.setAttribute('tabindex', '-1');
				el.focus({ preventScroll: true });
			}
			// `started` hlídá, že se to nedá nasčítat opakovaným spuštěním.
			ga('player_start', {
				network: frame.dataset.network,
				model: frame.dataset.model,
				mode,
			});
		}

		play?.addEventListener('click', () => startEmbed('click'), { once: true });

		/**
		 * Stránka se stavěla jako offline, ale modelka vysílá (D19). Pustíme
		 * stream rovnou — a jen když ho tahle síť utáhne bez interakce.
		 */
		document.addEventListener('ecamx:model-online', () => {
			if (frame?.hasAttribute('data-autoplay')) startEmbed('auto');
			else if (play) play.hidden = false;
		});

		/**
		 * BongaCams: HLS v našem `<video>` (D62). Rámec z jejich domény je na
		 * EasyListu, tohle není rámec.
		 *
		 * Tři věci, na kterých to jinak spadne:
		 *  1. **HTTP 200 neznamená stream.** Playlist neexistující nebo skončené
		 *     modelky má 25 bajtů a nula variant — pozná se jen po obsahu.
		 *  2. **Adresa zastarává.** Nese shard (`ded…-edge….bcvcdn.com`), který
		 *     z nicku neodvodíš, a modelka ho po reconnectu mění; medián
		 *     vysílání je 1,2 h, sync jde po 2 h. Jednou se tedy zkusí čerstvý
		 *     host z `/api/online/…/?s=1` a teprve pak se to vzdá.
		 *  3. **Mrtvý přehrávač je horší než žádný** (past u `hasPlayer`). Když
		 *     stream nenaběhne, `<video>` zmizí a odkryje se odkaz do pokoje —
		 *     tedy přesně stav, jaký tu byl do 27. 8.
		 *
		 * Knihovna se tahá jen tam, kde je potřeba: Safari a iOS přehrají HLS
		 * nativně, ostatní dostanou `hls.js/light` jako lazy chunk (113 kB gz,
		 * což jsou při 488 kbps zhruba dvě sekundy streamu).
		 */
		/**
		 * Rozjede HLS na daném `<video data-hls>`. Vytažené do funkce, protože
		 * od D67 se totéž potřebuje i na **náhradním** streamu, když modelka
		 * dovysílala — a tenhle kód je jediné místo, které umí obojí cestu
		 * (nativní i přes knihovnu) včetně obnovy adresy a tichého fallbacku.
		 */
		function startHls(hlsVideo: HTMLVideoElement, onFail?: () => void): void {
			const fallback = document.querySelector<HTMLElement>('[data-hls-fallback]');
			// Nick s kapitalizací: `api_v=2` je case-sensitive (malými odpoví
			// „Invalid model username"). V cestě playlistu naopak nezáleží.
			const user = hlsVideo.dataset.nick ?? '';
			const net = hlsVideo.dataset.network ?? '';
			let refreshed = false;

			const giveUp = () => {
				hlsVideo.remove();
				if (onFail) onFail();
				else if (fallback) fallback.hidden = false;
			};

			/**
			 * Čerstvá adresa, když ta z buildu neplatí. Jen jednou za zobrazení
			 * stránky — víc dotazů by nic nezlepšilo a `/api/` sdílí okno rate
			 * limitu s vydělávajícím `/go/` (D49).
			 */
			const freshSrc = async (): Promise<string | null> => {
				if (refreshed || !user) return null;
				refreshed = true;
				try {
					const r = await fetch(`/api/stream/${net}/${encodeURIComponent(user)}/`,
						{ signal: AbortSignal.timeout(8000) });
					const data = await r.json() as { url?: string; offline?: boolean };
					return data?.url ?? null;
				} catch { return null; }
			};

			/**
			 * U Cam4 je adresa z buildu vždycky mrtvá, tak se rovnou tahá čerstvá.
			 *
			 * Změřeno: 12 h stará adresa vracela 404 u 8 z 8 modelek, a build je
			 * i za nejlepších okolností až 6 h starý — první pokus by se tedy
			 * netrefil nikdy a jen by přehrávač zdržel o jedno kolo.
			 * BongaCams tu schválně není: 40 minut po syncu jich pořád hrálo
			 * 14 z 25 (D62), takže tam se stará adresa vyplatí zkusit.
			 */
			const firstSrc = async (): Promise<string | null> =>
				(net === 'cam4' ? await freshSrc() : null) ?? hlsVideo.dataset.hls ?? null;

			const played = () => ga('player_auto', {
				network: net, model: hlsVideo.dataset.model, mode: 'hls',
			});

			// Safari a iOS: HLS nativně, žádná knihovna.
			if (hlsVideo.canPlayType('application/vnd.apple.mpegurl')) {
				const native = (src: string) => {
					hlsVideo.src = src;
					hlsVideo.play().catch(() => { /* politika autoplaye, ovládání zůstává */ });
				};
				hlsVideo.addEventListener('error', () => {
					void freshSrc().then((src) => (src ? native(src) : giveUp()));
				});
				hlsVideo.addEventListener('playing', played, { once: true });
				void firstSrc().then((src) => (src ? native(src) : giveUp()));
			} else {
				void (async () => {
					const { default: Hls } = await import('hls.js/light');
					if (!Hls.isSupported()) return giveUp();
					// `startLevel: 0` = 240p na začátek (488 kbps); víc si vezme
					// samo podle velikosti přehrávače. Kdo profil jen prolétne,
					// nestáhne 3,4 Mbps.
					const hls = new Hls({ startLevel: 0, capLevelToPlayerSize: true, maxBufferLength: 12 });
					const retry = () => {
						void freshSrc().then((src) => {
							if (!src) return giveUp();
							hls.loadSource(src);
						});
					};
					hls.on(Hls.Events.MANIFEST_PARSED, () => {
						// Prázdný playlist projde jako 200 — poznáme ho podle nuly variant.
						if (!hls.levels.length) return retry();
						hlsVideo.play().catch(() => { /* ovládání zůstává divákovi */ });
					});
					hls.on(Hls.Events.ERROR, (_e: unknown, data: { fatal: boolean }) => { if (data.fatal) retry(); });
					hlsVideo.addEventListener('playing', played, { once: true });
					hls.attachMedia(hlsVideo);
					const src = await firstSrc();
					if (!src) return giveUp();
					hls.loadSource(src);
				})();
			}
		}

		const pageVideo = document.querySelector<HTMLVideoElement>('video[data-hls]');
		if (pageVideo) startHls(pageVideo);

		/**
		 * **Modelka dovysílala → pustí se někdo jiný ze stejné sítě.**
		 *
		 * Kenny 29. 8.: „chci aby fungoval stream když na ně kliknu
		 * a neobjevovalo se mi tam just ended the stream." Statická stránka to
		 * sama zaručit nemůže: build je i za nejlepších okolností až 6 h starý
		 * (D65) a za tu dobu dovysílá většina pokojů — změřeno na 13,9 h starém
		 * buildu, kdy bylo z 60 karet živých 12. Živý feed to ale ví, a od D67
		 * z něj `/api/online/{síť}/?cards=N` vrací hotové karty i s adresou
		 * přehrávače.
		 *
		 * Co se NEMĚNÍ: nadpis, drobečky ani JSON-LD. Stránka je pořád o té
		 * modelce, kvůli které sem člověk přišel — jen v ploše přehrávače běží
		 * někdo jiný a proužek nad ním to říká nahlas. Přesměrovat by znamenalo
		 * lhát návštěvníkovi z Bingu i Bingu samotnému.
		 */
		document.addEventListener('ecamx:model-offline', (ev) => {
			const { network } = (ev as CustomEvent<{ network: string; slug: string }>).detail;
			const frame = document.querySelector<HTMLElement>('[data-player]');
			// Jméno a slug se čtou z rámce, ne z `define:vars`: ten by ze
			// skriptu udělal inline kód na každé stránce a CSP by místo dvou
			// hashů měla tisíce (past 94).
			const pageName = frame?.dataset.name ?? 'She';
			const pageSlug = frame?.dataset.slug ?? '';
			const pageModel = frame?.dataset.model ?? '';
			const note = document.querySelector<HTMLElement>('[data-substitute-note]');
			const text = note?.querySelector<HTMLElement>('[data-substitute-text]');
			const offlineBlock = document.querySelector<HTMLElement>('[data-player-offline]');
			if (!frame) return;

			// Mrtvý rámec pryč vždycky — i kdyby náhrada nedopadla (D63).
			for (const el of frame.querySelectorAll('iframe, video, .play-overlay, .player-hit')) el.remove();
			const giveUpAll = () => { if (offlineBlock) offlineBlock.hidden = false; };

			void (async () => {
				let cards: Array<{ s: string; n: string; t: string; v: number; e: string }> = [];
				try {
					const r = await fetch(`/api/online/${network}/?cards=8`, { signal: AbortSignal.timeout(6000) });
					cards = (await r.json())?.cards ?? [];
				} catch { /* feed nedojel — spadne to na hlášku */ }

				/**
				 * Náhrada musí mít přehrávač — prázdná plocha je horší než
				 * poctivá hláška.
				 *
				 * U BongaCams adresa ve feedu není schválně: mřížka ji
				 * nepotřebuje a celý feed má 4,4 MB, takže se čerstvá adresa
				 * bere z `/api/stream/bongacams/{nick}/` pro JEDNU modelku
				 * (2,8 kB, D62). Právě u téhle sítě si Kenny stěžoval, že klik
				 * nikam nevede, takže ji vynechat nelze.
				 */
				let pick = cards.find((c) => c.e && c.s !== pageSlug);
				if (!pick && network === 'bongacams') {
					// Nejvýš tři pokusy: `/api/` sdílí okno rate limitu 40 req/10 s
					// s vydělávajícím `/go/` (D49), a když nevysílá ani jedna
					// z prvních tří nejsledovanějších, je čas přiznat barvu.
					for (const c of cards.filter((x) => x.s !== pageSlug).slice(0, 3)) {
						try {
							const r = await fetch(`/api/stream/${network}/${encodeURIComponent(c.n)}/`,
								{ signal: AbortSignal.timeout(6000) });
							const u = (await r.json())?.url;
							if (u) { pick = { ...c, e: `hls:${u}` }; break; }
						} catch { /* další modelka */ }
					}
				}
				if (!pick) return giveUpAll();

				const done = () => {
					if (text) text.textContent =
						`${pageName} just ended — now playing ${pick.n}.`;
					if (note) note.hidden = false;
					// Na stránce, která se stavěla jako offline, leží přes plochu
					// hláška „isn't streaming right now" — přes běžící stream by
					// to byl nesmysl.
					document.querySelector<HTMLElement>('[data-offline-msg]')?.setAttribute('hidden', '');
					ga('player_substitute', { network, model: pageModel || pick.s });
				};

				if (pick.e.startsWith('hls:')) {
					const v = document.createElement('video');
					v.className = 'absolute inset-0 h-full w-full bg-black object-contain';
					v.dataset.hls = pick.e.slice(4);
					v.dataset.nick = pick.n;
					v.dataset.network = network;
					v.muted = true; v.autoplay = true; v.playsInline = true; v.controls = true;
					v.preload = 'none';
					frame.appendChild(v);
					startHls(v, giveUpAll);
					done();
				} else {
					const el = document.createElement('iframe');
					el.src = pick.e;
					el.title = `${pick.n} live webcam`;
					el.allowFullscreen = true;
					el.referrerPolicy = 'strict-origin-when-cross-origin';
					el.setAttribute('allow', 'autoplay; fullscreen');
					frame.appendChild(el);
					done();
				}
			})();
		});

		// U sítí v AUTOPLAY_SAFE se iframe renderuje ze serveru a žádný klik
		// není — bez tohohle by u čtyř ze šesti sítí spuštění přehrávače
		// v datech vůbec nebylo. Měří se `load`, ne přítomnost elementu:
		// zajímá nás, že se stream opravdu načetl.
		const autoFrame = document.querySelector<HTMLElement>('[data-player]:not([data-embed]) iframe');
		if (autoFrame) {
			const host = autoFrame.closest<HTMLElement>('[data-player]');
			autoFrame.addEventListener('load', () => {
				ga('player_auto', {
					network: host?.dataset.network,
					model: host?.dataset.model,
					mode: 'auto',
				});
			}, { once: true });
		}
	</script>
	{/* Lepivý pásek. Místo pro něj je rezervované v CSS (`.sticky-cta`), takže
	    jeho zobrazení nic neposune — CLS musí zůstat 0 (past 52). Odkrývá ho
	    skript, až přehrávač vyjede z obrazovky. */}
	<a
		class="sticky-cta"
		data-sticky-cta
		href={ctaSticky}
		rel="nofollow sponsored noopener"
		target={outTarget}
	>
		{model.online
			? `Chat with ${model.displayName} on ${label} →`
			: `Open ${model.displayName}'s profile on ${label} →`}
	</a>
</Layout>
