---
/**
 * Stránka modelky — cíl každého kliku z mřížky a místo, kam dopadá longtail
 * dotaz na nick (GSC potvrzuje: `dulcesecreto69` pozice 10, `shandateneyck` 7).
 *
 * Dvě varianty:
 *   online  — přehrávač nahoře, CTA vedle něj i pod ním, na mobilu sticky lišta
 *   offline — bez přehrávače, protože není co přehrát. Místo něj kdy naposled
 *             vysílala, odkaz na její profil (pořád affiliate) a hlavně mřížka
 *             živých podobných. Bez toho by to byla slepá ulička.
 *
 * Do indexu jde jen modelka s `indexable` (viděná aspoň 3 různé dny) — zbytek
 * má `noindex, follow`, aby se neopakoval index bloat starého webu (D8).
 */
import Layout from '../../layouts/Layout.astro';
import ModelCard from '../../components/ModelCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
	MODEL_PAGES, linkableCategories, similarLive, topDemand, demandRotation, titleVariant,
	NETWORK_LABELS, countryName, canonicalCountry, linkableCountry, linkableNetwork,
	facetLabel, usualHours, PER_MINUTE_NETWORKS, outTargetFor, type Model,
} from '../../lib/data';
import { canonicalLanguage } from '../../lib/taxonomy';
import { embedUrl, goLink } from '../../lib/affiliate';
import { profileSeo, SITE_URL } from '../../lib/seo';
import { aboutParagraphs, contextParagraphs, faqItems, historyParagraphs } from '../../lib/model-copy';
import { buildCrossNetwork } from '../../lib/cross-network';
import { safeJsonLd } from '../../lib/jsonld';

export function getStaticPaths() {
	return MODEL_PAGES.map((m) => ({ params: { slug: m.page }, props: { model: m } }));
}

// Mimo frontmatter i mimo getStaticPaths: modulový scope se vyhodnotí jednou
// za build (past D32 platí obráceně — sem getStaticPaths dosáhne, ale na
// frontmatter ne).
const CROSS_NETWORK = buildCrossNetwork(MODEL_PAGES);

const { model } = Astro.props as { model: Model };
/**
 * Stejný nick na jiné síti. Počítá se jednou pro celý build (modul si mapu
 * drží), takže 16 000 stránek stojí jeden průchod, ne 16 000.
 */
const twins = CROSS_NETWORK.get(model.page) ?? [];
const label = NETWORK_LABELS[model.network];
// Země musí projít normalizací: BongaCams ji posílá jako volný text psaný
// performerkou, takže bez ní se na profilu ukázalo „COLOMBIA" nebo „РОССИЯ".
const countryCode = canonicalCountry(model.country);
const countryLabel = countryCode ? countryName(countryCode) : null;
// Odkaz jen tam, kde stránka země opravdu existuje (práh 20 modelek).
const countryHref = linkableCountry(model.country);
/** `/site/{síť}/` existuje jen když síť v tomhle běhu feed vrátila. */
const networkLink = linkableNetwork(model.network);
const networkHref = networkLink ? `/site/${networkLink}/` : null;

// Text sestavený z uložených dat — jediná část stránky, kterou nemá nikdo jiný.
// Nic se tu nevymýšlí, viz pravidla v src/lib/model-copy.ts (D26).
// U archivní stránky (`model.archived`) katalog nemá NIC než nick a síť —
// `aboutParagraphs` i `historyParagraphs` staví text z počtu viděných dnů,
// štítků a země, takže by si u ní musely vymýšlet. Radši žádný text.
const about = model.archived ? [] : aboutParagraphs(model, label, countryLabel);
const history = model.archived ? [] : historyParagraphs(model);
// Kontext z katalogu (kolik pokojů té sítě vedeme, jak velké publikum má proti
// ostatním, kolik modelek máme z její země) + věta „co to stojí". Archivní
// stránka ho nedostane ze stejného důvodu jako zbytek textu — nemá data.
const context = model.archived ? [] : contextParagraphs(model, label, countryLabel);
// Otázky v těch tvarech, ve kterých je lidé opravdu píšou (změřeno na 3 141
// dotazech z Bingu). Odpovědi jsou z dat; na co data nemáme, se neptáme.
const faq = model.archived ? [] : faqItems(
	model, label, countryLabel,
	twins.filter((t) => t.tier !== 'conflicting').map((t) => NETWORK_LABELS[t.network]),
);
const cats = linkableCategories(model);
// Kolik podobných ukázat a kolik jich dát do HTML jako rezervu pro doplnění
// za offline karty. Na vstupních mřížkách je rezerva 3×, tady jen 1,5× —
// stránek modelek je přes 10 000 a každá karta je ~1,3 kB, takže větší rezerva
// by nafoukla build a prodloužila CI nad rozpočet free minut.
const SIMILAR_VISIBLE = model.online ? 10 : 20;
/**
 * Čtyři živé karty nad ohyb u offline modelky. Bere se z už spočítaného
 * `similarLive()`, takže to nic nestojí navíc — jen se to zobrazí dřív.
 */
const QUICK_LIVE = 4;
const similar = similarLive(model, Math.round(SIMILAR_VISIBLE * 1.5));
const quickLive = model.online ? [] : similar.slice(0, QUICK_LIVE);
/**
 * Nejhledanější modelky podle měřené poptávky (D35). Textové odkazy, ne karty:
 * 24 karet by stránku nafouklo o ~30 kB × 17 000 stránek, kdežto 24 odkazů
 * stojí 1,5 kB. Smysl je prolinkování — vnitřní odkazy mají mířit tam, kde je
 * poptávka, protože ty stránky mají reálnou šanci na TOP 3 (Ahrefs: 201 220
 * hledání/měs na nicky v katalogu při KD 0–24). Konkurent, který na nick
 * `ehotlovea` stojí #3, má na stránce modelky 83 odkazů na jiné modelky; my
 * jsme měli 30.
 */
const searched = topDemand(24, model.page);
/** Rotující odkazy na celou množinu stránek s poptávkou, i offline (D79). */
const popular = demandRotation(model.page, 16, new Set(searched.map((m) => m.page)));

/**
 * Sítě, u kterých se přehrávač smí spustit hned. Chrome odstraní iframe jen
 * tehdy, když ho podle filtrovacího seznamu označí za REKLAMU — a `/embed/`
 * u těchhle pěti na EasyList ani EasyPrivacy není (ověřeno, hlídá
 * `scripts/check-blocklists.ts`). U LiveJasminu (`ptcdw.com`) a XLoveCamu
 * na seznamu jsou, takže tam zůstává poster + klik: jinak by Chrome rámec
 * po 4 MB přenosu zabil a uživatel by koukal na hlášku o reklamě (D13).
 *
 * Kdyby se některý z těch hostů na seznam dostal, guard v CI spadne — a tenhle
 * seznam se musí zkrátit, ne guard obejít.
 */
// BongaCams odsud 26. 8. vypadl kvůli EasyListu, ale 27. 8. se VRÁTIL: jede
// v našem `<video>` přes HLS z jejich feedu, ne v rámci (D62). Podmínka 1 se
// tedy netýká — na `<video>` `$subdocument` ani Heavy Ad Intervention neplatí
// a `bcvcdn.com` na seznamech není. Podmínka 2 platí: stream je ztišený,
// takže autoplay projde.
/**
 * Sítě, u kterých se rámec renderuje ze serveru a stream **naskočí sám**.
 * Podmínky jsou dvě a obě se měří, ne hádají:
 *  1. host není na blokovacích seznamech — jinak ho Chrome označí za reklamu
 *     a po 4 MB odstraní (D13, a přesně to se 26. 8. stalo BongaCams),
 *  2. embed opravdu hraje bez interakce. Ověřeno 26. 8. s restriktivní
 *     politikou (`--autoplay-policy=document-user-activation-required`):
 *     stripchat a imlive přes `suaplf.live` hrají ztišené samy, **streamate
 *     (`purecam`) Chrome zablokuje** (video není ztišené), takže tam zůstává
 *     klik. XLoveCam a LiveJasmin jsou na EasyListu → klik navždy.
 * Viz D59.
 */
const AUTOPLAY_SAFE = new Set(['chaturbate', 'camsoda', 'cam4', 'stripchat', 'imlive', 'bongacams']);

/**
 * Sítě, u kterých se nad stream vkládá klikací vrstva (`.player-hit`).
 *
 * Chaturbate: ověřeno 18. 8., že `/embed/` NENASTAVÍ affiliate cookie ani
 * s `campaign`, ani s `tour` — cookie dává jedině `/in/`. Klik uvnitř rámce
 * tedy končil na `/auth/login/?next=/{room}/` bez provize, a byl to nejsilnější
 * klik na webu. Embed proto jede `embed_video_only=1` (bez chatu a tipů, takže
 * v rámci nezbylo, co by kradlo klik) a klik do plochy videa posílá vrstva na
 * `/go/`, tedy top-level navigaci přes `/in/`, která provizi přiřadí.
 *
 * Ostatních šest sítí nese affiliate ID přímo v embed URL, takže tam klik
 * uvnitř rámce ztracený být nemusí — audit každé z nich je samostatná položka
 * v HANDOFF.md, ne odhad. Viz D34.
 */
const STREAM_LINK = new Set(['chaturbate']);
const autoplay = AUTOPLAY_SAFE.has(model.network);

const embed = embedUrl(model.network, model.username, undefined, model.embedRef);
/**
 * BongaCams: místo rámce HLS playlist v našem `<video>` (D62). Marker `hls:`
 * je princip po `widget:` u Amateur.tv (ten zmizel s widgetem, D63) —
 * `embedUrl()` nesmí vracet něco, co by se omylem dalo strčit do `iframe.src`.
 */
const isHls = embed.startsWith('hls:');
const hlsSrc = isHls ? embed.slice(4) : '';
/**
 * Sítě bez přehrávače: Streamate/ImLive, u kterých chybí `embedRef`, a každá
 * modelka, u které chybí adresa streamu. Dřív se v takovém případě
 * vyrenderovalo tlačítko „Watch live", které po kliknutí **neudělalo nic** —
 * obsluha padá na `if (!src) return;`. Mrtvé tlačítko je horší než žádné, takže
 * zůstane náhled a CTA.
 */
const hasPlayer = embed.length > 0;
/**
 * Nový tab, nebo stejný? U sítě s plošným `$popup` pravidlem blokovač nový tab
 * zabije, takže se tam naviguje na místě (`POPUP_BLOCKED_NETWORKS`, D62).
 */
const outTarget = outTargetFor(model.network);
const ctaLive = goLink(model.network, model.username, 'profile');
const ctaPlayer = goLink(model.network, model.username, 'player');
const ctaOffline = goLink(model.network, model.username, 'offline');
/**
 * Lepivé CTA na mobilu. Stránka modelky nese 22 z 32 měřených prokliků
 * (GA4, 14 dní k 26. 8.), takže je to konverzní plocha webu — a na mobilu
 * hlavní tlačítko odscrolluje z obrazovky po prvních dvou odstavcích textu,
 * kterého tam je od 26. 8. 650 slov (D55). Pásek se měří jako `sticky`, aby
 * se za týden dalo říct, jestli vydělal. U offline modelky vede na profil,
 * ne do prázdného pokoje. Viz D58.
 */
const ctaSticky = model.online
	? goLink(model.network, model.username, 'sticky')
	: goLink(model.network, model.username, 'offline');

const seo = profileSeo({
	name: model.displayName,
	network: label,
	networkId: model.network,
	country: countryLabel,
	region: model.region,
	age: model.age,
	tags: cats.map((c) => c.label),
	online: model.online,
	lastSeen: model.last,
	subject: model.subject,
	archived: model.archived,
	variant: titleVariant(model.page),
});

/** „3 hours" / „2 days" — hrubě, přesnost tu nikoho nezajímá. */
function since(iso: string): string {
	const days = Math.round((Date.now() - new Date(iso + 'T00:00:00Z').getTime()) / 86_400_000);
	if (days <= 0) return 'today';
	if (days === 1) return 'yesterday';
	if (days < 14) return `${days} days ago`;
	return `${Math.round(days / 7)} weeks ago`;
}

function duration(seconds: number): string {
	const h = Math.floor(seconds / 3600);
	const m = Math.round((seconds % 3600) / 60);
	return h ? `${h}h ${m}m` : `${m}m`;
}

/**
 * Jazyky se čistí i tady, ne jen v syncu. Archivní stránky totiž běží ze
 * snapshotů uložených ještě starým parserem, který z „Spanish and English
 * (translator)" udělal tokeny `and` a `translator` — a ty se vypisovaly
 * návštěvníkovi. Kanonizace při renderu je zahodí bez čekání na další výskyt.
 */
const languages = [...new Set(
	(model.languages ?? []).map((l) => canonicalLanguage(l)).filter(Boolean) as string[]
)].map((l) => l.charAt(0).toUpperCase() + l.slice(1));

/** „20 February" — bez roku. Den a měsíc je fakt o modelce, rok je už její věk. */
const birthday = model.birthDate
	? new Date(model.birthDate + 'T00:00:00Z').toLocaleDateString('en-GB', {
		day: 'numeric', month: 'long', timeZone: 'UTC',
	})
	: null;

/**
 * Stav pokoje. `private` (u Chaturbate i `hidden`) znamená, že v přehrávači
 * návštěvník neuvidí nic — 199 ze 7 944 pokojů (2,5 %, změřeno 19. 8. 2026).
 * Do 19. 8. se pole `status` na webu vůbec nepoužívalo, takže takový pokoj
 * hlásil „Live now" a přehrávač pak ukázal placenou zeď. Odznak je levnější
 * než zklamání.
 */
const roomState = model.online && model.status === 'private' ? 'private'
	: model.online && model.status === 'away' ? 'away'
	: null;

/** Kdy ji vídáme online — jen když je vzorků dost (viz usualHours). */
const when = usualHours(model);

const attrs: [string, string][] = [
	['Site', label],
	...(countryLabel ? [['Country', countryLabel] as [string, string]] : []),
	// Kraj/město hlásí jen Chaturbate (pole `location`). Je to konkrétnější
	// než země a na stránce to nemá nikdo jiný — feed ho posílá u 24 % pokojů.
	...(model.region ? [['Region', model.region] as [string, string]] : []),
	// Věk mimo 18–80 je zjevně vyplněná blbost (feedy hlásí i 0 a 99).
	...(model.age && model.age >= 18 && model.age <= 80
		? [['Age', String(model.age)] as [string, string]] : []),
	...(birthday ? [['Birthday', birthday] as [string, string]] : []),
	...(model.gender ? [['Gender', model.gender] as [string, string]] : []),
	...(model.ethnicity ? [['Ethnicity', model.ethnicity] as [string, string]] : []),
	...(model.hairColor ? [['Hair', model.hairColor] as [string, string]] : []),
	...(model.eyeColor ? [['Eyes', model.eyeColor] as [string, string]] : []),
	...(model.bodyType ? [['Body', model.bodyType] as [string, string]] : []),
	...(model.bustSize ? [['Bust', model.bustSize] as [string, string]] : []),
	...(languages.length ? [['Languages', languages.slice(0, 3).join(', ')] as [string, string]] : []),
	// „Streaming for 55m" u offline modelky si odporuje s nadpisem — je to
	// hodnota z posledního výskytu, ne z teď.
	...(model.online && model.onlineSeconds
		? [['Streaming for', duration(model.onlineSeconds)] as [string, string]] : []),
	...(model.followers ? [['Followers', model.followers.toLocaleString('en-US')] as [string, string]] : []),
	// Vlastní měření, ne údaj ze sítě — proto ta formulace v labelu.
	...(when ? [['Usually live', `${String(when.from).padStart(2, '0')}:00–${String(when.to).padStart(2, '0')}:00 UTC`] as [string, string]] : []),
	...(model.photos ? [['Photos', String(model.photos)] as [string, string]] : []),
	...(model.videos ? [['Videos', String(model.videos)] as [string, string]] : []),
];

/**
 * ProfilePage + Person a u živé modelky navíc **VideoObject s BroadcastEvent**.
 *
 * Dřív tu byl komentář, že VideoObject nevydáváme, protože adult obsah je
 * z video rich results vyloučený. To pořád platí — jen to není celý důvod,
 * proč tu značka má být. Změřeno 19. 8.: z celého webu má Google indexovanou
 * **jedinou stránku** (homepage), stránky modelek hlásí „Crawled – currently
 * not indexed". Bez odkazů je jediná páka na crawl **Google Indexing API**,
 * a to bere výhradně `JobPosting` a `BroadcastEvent`. Tyhle stránky živé
 * vysílání doslova jsou, takže je to pravdivý popis, ne trik pro rich results
 * (ty u adultu nebudou a nečekáme je).
 *
 * `startDate` se počítá z `onlineSeconds` — jak dlouho už vysílá. Když ho síť
 * neposílá, `BroadcastEvent` se vynechá celý: datum vysílání si nevymýšlíme.
 */
const startedAt = model.online && model.onlineSeconds
	? new Date(Date.now() - model.onlineSeconds * 1000).toISOString()
	: null;

const videoObject = model.online ? {
	'@type': 'VideoObject',
	'@id': `${SITE_URL}/live/${model.page}/#stream`,
	name: `${model.displayName} live webcam on ${label}`,
	description: seo.description,
	isFamilyFriendly: false,
	// Náhled je hotlink z CDN sítě a u některých sítí má podepsanou expiraci —
	// pro schema je to pořád platný thumbnail, jen nesmí být povinný.
	...(model.thumbnail ? { thumbnailUrl: [model.thumbnail] } : {}),
	uploadDate: model.first,
	embedUrl: embed,
	...(startedAt ? {
		publication: {
			'@type': 'BroadcastEvent',
			isLiveBroadcast: true,
			startDate: startedAt,
		},
	} : {}),
} : null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${SITE_URL}/live/${model.page}/#page`,
			name: `${model.displayName} — live cam on ${label}`,
			dateModified: model.last,
			isFamilyFriendly: false,
			...(videoObject ? { mainEntityOfPage: { '@id': `${SITE_URL}/live/${model.page}/#stream` } } : {}),
			mainEntity: {
				'@type': 'Person',
				name: model.displayName,
				...(model.thumbnail ? { image: model.thumbnail } : {}),
				...(countryLabel ? {
					homeLocation: {
						'@type': 'Place',
						name: model.region ? `${model.region}, ${countryLabel}` : countryLabel,
						...(model.region ? {
							address: {
								'@type': 'PostalAddress',
								addressRegion: model.region,
								addressCountry: countryCode,
							},
						} : {}),
					},
				} : {}),
				...(languages.length ? { knowsLanguage: languages.slice(0, 3) } : {}),
				...(cats.length ? { knowsAbout: cats.map((c) => c.label) } : {}),
			},
		},
		...(videoObject ? [videoObject] : []),
	],
};
---
<Layout title={seo.title} description={seo.description} noindex={!model.indexable}>
	<script type="application/ld+json" is:inline set:html={safeJsonLd(jsonLd)} slot="head" />

	<Breadcrumbs items={[
		// Když síť vypadla z feedu, její stránka neexistuje — drobeček pak míří
		// na rozcestník, který existuje vždy. Bez tohohle spadne `check-links`.
		{ label: label, href: networkHref ?? '/site/' },
		{ label: model.displayName },
	]} />

	<div class="mt-2 grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
		<div>
			{/* „Live Sex Cam" / „Webcam" podle měřených dotazů: GSC ukazuje
			    `<nick> cam` (197 impresí, pozice 11), `<nick> webcam` (133, 9,3)
			    a samotný nick (151, 14,5) — tvary, na které stránka reálně sedí. */}
			<div class="flex flex-wrap items-start justify-between gap-3">
				<h1 class="text-2xl font-extrabold sm:text-3xl">
					{model.online
						? `${model.displayName} Live Sex Cam — ${label}`
						: `${model.displayName} Webcam — ${label} Cam Profile`}
				</h1>
				{/*
				  Sledování. Tlačítko je v HTML od prvního snímku a skript mu jen
				  přepíše text — nic se nezjevuje ani nemění šířku (past 52).
				  Stav i logika jsou klientské, viz src/lib/watchlist.ts.
				*/}
				<button
					type="button" class="watch-btn" aria-pressed="false"
					data-watch-toggle data-watch-source="profile"
					data-page={model.page}
					data-network={model.network}
					data-username={model.username}
				><span data-watch-label>Follow</span></button>
			</div>

			{/*
			  `data-live-scope` napojuje tenhle blok na klientský živý stav
			  v Layout.astro. Bez toho zůstal odznak na hodnotě z buildu, takže
			  stránka hlásila „Live now, 58 433 watching", zatímco přehrávač
			  vedle psal „Room is currently offline".
			*/}
			<div class="mt-2 flex flex-wrap items-center gap-2 text-sm" data-live-scope>
				{model.online
					? <span class="badge bg-live" data-live-badge={`${model.network}:${model.slug}`}
					        data-build-viewers={model.viewers ?? 0}>Live now</span>
					: <span class="badge bg-ink-700" data-live-badge={`${model.network}:${model.slug}`}
					        data-build-viewers="0">Offline</span>}
				{roomState === 'private' && (
					<span class="badge bg-ink-700">Private show — stream hidden</span>
				)}
				{roomState === 'away' && <span class="badge bg-ink-700">Away from cam</span>}
				{model.isHd && <span class="badge bg-ink-700">HD</span>}
				{model.isNew && <span class="badge bg-ink-700">New</span>}
				{model.toy && <span class="badge bg-toy">Interactive toy</span>}
				{model.online && model.viewers != null && (
					<span class="text-ink-400" data-viewers={`${model.network}:${model.slug}`}>
						{model.viewers.toLocaleString('en-US')} watching
					</span>
				)}
				{!model.online && !model.archived && (
					<span class="text-ink-400">Last live {since(model.last)}</span>
				)}
			</div>

			{model.online ? (
				<>
					{/*
					  Přehrávač se spouští AŽ NA KLIK. Dva důvody:
					  1) Chrome odstraní cross-origin iframe, se kterým uživatel
					     nic neudělal a který přenese víc než 4 MB (Heavy Ad
					     Intervention) — a to živý stream utáhne za pár sekund.
					     Interakce uživatele rámec z intervence vyjímá.
					  2) Kdo profil jen prolétne, nestahuje desítky MB videa.
					*/}
					<div
						class="player-frame mt-4"
						data-player
						data-embed={isHls || autoplay || !hasPlayer ? undefined : embed}
						data-title={`${model.displayName} live webcam`}
						data-network={model.network}
